NODE_ENV="development"
DATABASE_URL="postgresql://marketops:marketops@127.0.0.1:5432/marketops"
# JWT_SECRET é um fallback exclusivo de desenvolvimento. Produção exige os secrets separados abaixo.
JWT_SECRET="troque-por-um-segredo-local-com-no-minimo-32-caracteres"
ACCESS_TOKEN_SECRET=""
OAUTH_STATE_SECRET=""
FILE_SIGNING_SECRET=""
# Produção: chave base64 de 32 bytes (`openssl rand -base64 32`).
GOOGLE_TOKEN_ENCRYPTION_KEY=""
JWT_EXPIRES_IN="8h"
PORT=3001
CORS_ORIGIN="http://localhost:8443,http://localhost:5174"
TRUST_PROXY="false"

# E-mail (Gmail API / OAuth2) — usado no fluxo de "esqueceu a senha"
# O log do código é permitido somente em desenvolvimento e quando habilitado explicitamente.
# Gere GMAIL_REFRESH_TOKEN rodando: pnpm tsx server/scripts/get-gmail-refresh-token.ts
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER="noreply.marketops@gmail.com"
EMAIL_FROM_NAME="CITi HubSpot"
RESET_CODE_TTL_MINUTES=15
RESET_TOKEN_TTL_MINUTES=15
ALLOW_RESET_CODE_LOG=true
ALLOW_LEGACY_GOOGLE_TOKENS=true

# Upload de arquivos (materiais ricos e mídia de posts)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=20
FILE_VIEW_TTL_SECONDS=3600
FILE_DOWNLOAD_TTL_SECONDS=60

# O seed só cria gerente quando as duas variáveis forem informadas.
MANAGER_EMAIL=""
MANAGER_PASSWORD=""
MANAGER_NAME=""
